{
    "name": "omnidrive/gdrive",
    "type": "library",
    "description": "Omnidrive Google Drive: a folder of Google Drive (My Drive or a shared drive) as an omnidrive drive, through masbug/flysystem-google-drive-ext - OAuth refresh token or service account, paths by name.",
    "keywords": ["storage", "google-drive", "flysystem", "omnidrive"],
    "homepage": "https://github.com/glitchr-omnisense/omnidrive-gdrive",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "google/apiclient": "^2.15",
        "google/auth": "^1.37",
        "guzzlehttp/guzzle": "^7.0",
        "masbug/flysystem-google-drive-ext": "^2.5",
        "omnisense/omnidrive": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnidrive\\Gdrive\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnidrive\\Gdrive\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
